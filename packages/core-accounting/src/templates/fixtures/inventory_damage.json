{
  "template_code": "inventory_damage",
  "template_version": 1,
  "scope": ["retail"],
  "category": "damage",
  "ui": { "button_group_ar": "تالف", "display_name_ar": "بضاعة تالفة", "icon": "broken_box",
          "description_ar": "سجّل بضاعة تلفت ووزّع قيمتها", "sort_order": 1 },
  "allow_distribution": true,
  "fields": [
    { "key": "total_amount", "type": "amount", "label_ar": "القيمة الإجمالية", "required": true },
    { "key": "distribution", "type": "distribution_table", "label_ar": "التوزيع", "required": true,
      "validation": "sum(distribution[].percentage) == 100" }
  ],
  "journal_rules": [
    {
      "account_code_ref": "map_target_to_account({{distribution[i].target_type}})",
      "side": "debit",
      "amount_formula": "apportion({{total_amount}}, {{distribution[i].percentage}})",
      "contact_ref": "{{distribution[i].contact_id}}",
      "repeat_for": "distribution",
      "rounding_anchor_field": "total_amount"
    },
    { "account_code_ref": "1310", "side": "credit", "amount_formula": "{{total_amount}}" }
  ]
}
